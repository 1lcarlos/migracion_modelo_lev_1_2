# Copiar a .env y completar. .env NO se versiona (ver .gitignore).
# Conexión PostgreSQL (psql y pg_dump leen PGHOST/PGPORT/PGUSER/PGPASSWORD directamente)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Herramientas
PG_BIN="C:/Program Files/PostgreSQL/16/bin"
JAVA=java
ILI2PG_JAR="C:/ladm_col/desarrollos/creacion_modelos_fisicos/windows_version/ili2pg/ili2pg-5.5.1/ili2pg-5.5.1.jar"
MODELDIR="LADM_COL_Lev_Cat_v1_2_docs"
# ilivalidator (validación final obligatoria en scripts/lote.py); por defecto la copia local en ili2pg/
ILIVALIDATOR_JAR="ili2pg/ilivalidator-1.15.0/ilivalidator-1.15.0.jar"
# Opcional: memoria máxima de Java para ili2pg/ilivalidator (municipios grandes, p. ej. Facatativá)
# JAVA_XMX=4g

# BD ya migrada desde la que se clona el esquema lev_cat_12 (estructura + catálogos)
BD_PLANTILLA_LEV12=tibacuy_lev12
