# Parámetros de migración — Nemocón (Cundinamarca), backup v2023 complementado con el XTF del
# operador (6-feb-2023, solo zona urbana). Mismo backup, MUN y reglas que nemocon.env (OID y nombre
# de XTF iguales); BD aparte para conservar nemocon_lev12. Decisiones del usuario 2026-10-14:
# prevalece la base del gestor y el operador solo llena vacíos.
MUN=nemocon
ESQ=cun25486
BD=nemocon_v2023b_lev12
PREFIJO=NEMOCON_
VIGENCIA=2023
BACKUP=nemocon_25486_v2023_202610141544.sql

# Opcional: NIT para interesados del municipio con documento vacío (dejar vacío si no aplica)
RAZON_MUNICIPIO=
NIT_MUNICIPIO=

# Zonas homogéneas: el backup solo trae las rurales con vigencia 2021 (ZHF 29, ZHG 17); se toma la
# última vigencia <= VIGENCIA de cada tabla. Decisión del usuario 2026-10-14.
ZH_ULTIMA_VIGENCIA=si

# XTF del operador: contacto de visita, novedades de números prediales, observaciones de las unidades
# (características) y CC_Barrio/CC_LocalidadComuna (etapa complemento).
XTF_COMPLEMENTO=comparacion/nemocon/nemocon_20230206_1330.xtf
# El avalúo de las unidades del operador NO se toma: no cuadra con el avalúo 2023 del gestor (mediana
# 2,3 % del avalúo del predio) y el campo es opcional. Decisión del usuario 2026-10-14.
COMPLEMENTO_AVALUO_UNIDADES=no
# Predios con novedad Cancelacion del XTF del operador (76, sin avalúo 2023).
INCLUIR_CANCELADOS=si
# Linderos, puntos, fuentes espaciales, ZHF urbanas (66) y AV_TipologiaConstruccion (104) del
# operador (etapa operador). Las ZHG urbanas se conservan del gestor: misma geometría y zonas que
# las del operador, con el valor catastral 2023 (60 % del valor del operador).
COMPLEMENTO_OPERADOR=si
