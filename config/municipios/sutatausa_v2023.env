# Parámetros de migración — Sutatausa (Cundinamarca), backup de conservación con corte 2023
# Mismo MUN que sutatausa.env (OID y nombre de XTF iguales); BD separada para conservar la
# migración hecha con el backup de 2026 (sutatausa_lev12).
MUN=sutatausa
ESQ=cun25781
BD=sutatausa_v2023_lev12
PREFIJO=SUTATAUSA_
VIGENCIA=2023
BACKUP=sutatausa_25781_conservacion_v2023_202610061619.sql

RAZON_MUNICIPIO=
NIT_MUNICIPIO=

# Backup auxiliar (conservación 2026): se carga como esquema cun25781_v2026 (etapa auxiliar).
# De él solo se toman los valores por tipología (tb_valortipologia, vigencia 2023), que el
# backup de corte 2023 no trae. Decisión del usuario 2026-10-06.
BACKUP_AUX=sutatausa_25781_conservacion_v2026_202610061252.sql
ESQ_AUX=cun25781_v2026
ESQ_TIPOLOGIA=cun25781_v2026

# XTF del operador (3-feb-2023): contacto de visita, novedades de números prediales,
# avalúo/observaciones de unidades y CC_Barrio/CC_CentroPoblado. Decisión del usuario 2026-10-06.
XTF_COMPLEMENTO=comparacion/sutatausa/sutatausa_final.xtf
# Agregar los predios con novedad Cancelacion del XTF del operador (sin avalúo 2023; 165).
# Decisión del usuario 2026-10-06.
INCLUIR_CANCELADOS=si
